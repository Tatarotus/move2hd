TMDB_API_KEY=your_key_here
SAMBANOVA_API_KEY=your_key_here
LANGUAGE=pt-BR
SRC_DIR=.
RSYNC_PATH="/usr/bin/rsync"  # Verify with which rsync
DEST_FILMES=/media/sam/Videos/FILMES
DEST_SERIES=/media/sam/Videos/SERIES
DEST_ANIMES=/media/sam/Videos/ANIMES
DEST_PENDENTE=/media/sam/Videos/OUTROS
VALID_EXTENSIONS=.mp4,.mkv,.avi,.mov,.wmv,.flv
GENRES_ANIME=animação,animation,anime
# Western Digital Scorpio Blue optimizations
CHECKSUM_CHUNK_SIZE=131072  # 128KB for slower drives
MIN_TRANSFER_SPEED=5242880  # 5MB/s minimum
SPEED_TIMEOUT=600  # 10 minutes timeout
